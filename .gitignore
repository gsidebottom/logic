# Python venv created by `./setup.sh` (uv-managed).  `pyproject.toml`
# + `uv.lock` describe the env; `.venv` itself is regenerated
# per-machine via `uv sync`.
.venv/
__pycache__/
*.pyc

# OpenEvolve per-run artifacts (candidate sources, prompts, scores,
# LiteLLM proxy log).  Often hundreds of MB per run; reproducible
# from config.yaml + initial_program.rs.
evo/evolve/runs/

# don't save cometition benchmark results
evo/results/

# Phase-1 harvested phase dataset (derived; rebuild via neural/build_dataset.py)
neural/data/phase_ds*/
neural/data/synth_cnf/
matmul/challenges/
matmul/inst/
matmul/yalsat-bin
matmul/dbcache/
# Third-party + downloaded reference material (not ours to commit):
# Perminov's repo clone (~3 GB, has its own .git), fetched papers/pages.
# The committed, verified bits live in matmul/perminov_cache/bits/ and
# the verifier scripts are tracked; everything else here is external.
matmul/perminov_cache/repo/
matmul/perminov_cache/*.html
matmul/perminov_cache/*.pdf
matmul/perminov_cache/*.log
# Regenerable hunt corpora + run logs + derived intermediates.
