@@ -1,10 +1,69 @@
 #include "decide.h"
+#include "inline.h"
 #include "inlineframes.h"
 #include "inlineheap.h"
 #include "inlinequeue.h"
 #include "print.h"
 
 #include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+// Neural warm-start (NeuroBack-style): load predicted per-EXTERNAL-variable
+// phases once from $KISSAT_INITIAL_PHASES (signed DIMACS lits, 0-terminated,
+// `c` comment lines — the neural/phase_infer.py format).  Decision-order only.
+static void kissat_load_initial_phases (kissat *solver) {
+  solver->initial_phases_loaded = true;
+  const char *path = getenv ("KISSAT_INITIAL_PHASES");
+  if (!path)
+    return;
+  FILE *file = fopen (path, "r");
+  if (!file)
+    return;
+  unsigned maxvar = 0;
+  static char line[1 << 20];
+  for (int pass = 0; pass < 2; pass++) {
+    while (fgets (line, sizeof line, file)) {
+      if (line[0] == 'c')
+        continue;
+      char *p = line;
+      for (;;) {
+        char *q;
+        long v = strtol (p, &q, 10);
+        if (q == p)
+          break; // no more integers on this line
+        p = q;
+        if (v == 0)
+          continue;
+        unsigned a = (v < 0) ? (unsigned) -v : (unsigned) v;
+        if (pass == 0) {
+          if (a > maxvar)
+            maxvar = a;
+        } else if (a < solver->initial_phases_size) {
+          solver->initial_phases[a] = (v < 0) ? -1 : 1;
+        }
+      }
+    }
+    if (pass == 0) {
+      if (!maxvar)
+        break;
+      solver->initial_phases = calloc (maxvar + 1, 1);
+      if (!solver->initial_phases)
+        break;
+      solver->initial_phases_size = maxvar + 1;
+      rewind (file);
+    }
+  }
+  fclose (file);
+  if (solver->initial_phases) {
+    unsigned n = 0;
+    for (unsigned i = 1; i < solver->initial_phases_size; i++)
+      if (solver->initial_phases[i])
+        n++;
+    fprintf (stderr, "c neural: seeded %u initial phases from %s\n", n, path);
+    fflush (stderr);
+  }
+}
 
