+
   bool force = GET_OPTION (forcephase);
 
   value *target;
@@ -196,6 +258,22 @@ int kissat_decide_phase (kissat *solver, unsigned idx) {
     INC (saved_decisions);
   }
 
+  if (!res && solver->initial_phases) {
+    // Neural warm-start: use the predicted phase in place of the constant
+    // INITIAL_PHASE.  Map internal idx -> external var (polarity-aware: the
+    // export lit's sign undoes any import polarity flip).
+    const int elit = kissat_export_literal (solver, LIT (idx));
+    const unsigned evar = (elit < 0) ? (unsigned) -elit : (unsigned) elit;
+    if (evar && evar < solver->initial_phases_size) {
+      const signed char p = solver->initial_phases[evar];
+      if (p) {
+        res = (elit < 0) ? -p : p;
+        LOG ("%s uses neural initial phase %d", LOGVAR (idx), (int) res);
+        INC (initial_decisions);
+      }
+    }
+  }
+
   if (!res) {
     res = INITIAL_PHASE;
     LOG ("%s uses initial decision phase %d", LOGVAR (idx), (int) res);
