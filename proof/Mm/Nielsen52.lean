import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NoncommRing

/-!
# Nielsen's 52-addition alternative-basis scheme computes 3×3 matmul

Machine-checked correctness of the rank-23 Karstadt–Schwartz-style
scheme of Hugo Nielsen, "A 52-Addition, Rank-23 Scheme for Exact 3x3
Matrix Multiplication" (arXiv:2609.06588); data transcribed from the
paper's ancillary `small_verify.py` and generated by
`matmul/gen_nielsen52_lean.py`, which re-verifies the emitted program
exactly over the non-commutative ring ℤ⟨A,B⟩ before writing this file.

The pipeline is
  `vec C = BW⁻¹ ∘ W' ∘ (⊙23) ∘ (U' × V') ∘ (BU⁻¹ × BV⁻¹) (vec A, vec B)`
where `BU, BV, BW` are unimodular with all of `B·` and `B·⁻¹` having
entries in `{-1, 0, 1}`, `U'`/`V'` are 12-addition chains, and `W'` is a
28-addition chain.  **Cost model**: the paper's 52 = 12 + 12 + 28 counts
additions in the alternative basis only; the basis changes
`BU⁻¹/BV⁻¹/BW⁻¹` cost further additions (row-wise as presented: 6, 3
and 4), which Karstadt–Schwartz accounting amortizes across recursion
levels.  This differs from the flat (no-basis-change) model of
`Mm/Correct.lean`'s 55-addition record, so the two counts are not
comparable.

The statement is over a **general, not-necessarily-commutative** ring:
every product keeps its `A`-side factor on the left, so this certifies a
genuine bilinear algorithm that applies recursively to block matrices.
-/

namespace Nielsen52

variable {R : Type _} [Ring R]

set_option maxHeartbeats 1600000 in
-- `subst_vars` inlines the ~100 wires, making each of the 9 outputs one
-- large `noncomm_ring` goal; the default budget does not cover all nine.
/-- Each of the 9 outputs of the 52-addition alternative-basis scheme
equals the corresponding entry of `A · B`, over any ring.  Wires:
`ap*`/`bp*` are the basis-changed inputs `BU⁻¹ vec A` / `BV⁻¹ vec B`,
`u*`/`v*` the 12+12 input-side additions, `m1..m23` the products,
`s1..s28` the output-side additions, and `c* ` the entries of
`BW⁻¹` applied to the designated `s`-wires. -/
theorem correct
    (a11 a12 a13 a21 a22 a23 a31 a32 a33
     b11 b12 b13 b21 b22 b23 b31 b32 b33 : R)
    (ap0 bp0 ap1 bp1 ap2 bp2 ap3 bp3 ap4 bp4 ap5 bp5
     ap6 bp6 ap7 bp7 ap8 bp8 u1 u2 u3 u4 u9 u10
     u11 u17 u13 u15 u19 u23 v1 v2 v4 v7 v10 v11
     v17 v13 v15 v18 v19 v23 m1 m2 m3 m4 m5 m6
     m7 m8 m9 m10 m11 m12 m13 m14 m15 m16 m17 m18
     m19 m20 m21 m22 m23 s1 s2 s3 s4 s5 s6 s7
     s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19
     s20 s21 s22 s23 s24 s25 s26 s27 s28 c11 c12 c13
     c21 c22 c23 c31 c32 c33 : R)
    (hap0 : ap0 = a31 + a33)
    (hbp0 : bp0 = b21)
    (hap1 : ap1 = -a11 - a13)
    (hbp1 : bp1 = -b11 + b13)
    (hap2 : ap2 = a32)
    (hbp2 : bp2 = b12)
    (hap3 : ap3 = -a22)
    (hbp3 : bp3 = b23)
    (hap4 : ap4 = a13)
    (hbp4 : bp4 = b22 - b32)
    (hap5 : ap5 = a33)
    (hbp5 : bp5 = b11)
    (hap6 : ap6 = a11 + a12 + a13)
    (hbp6 : bp6 = b31)
    (hap7 : ap7 = a21 + a22 + a23)
    (hbp7 : bp7 = -b23 + b33)
    (hap8 : ap8 = -a21)
    (hbp8 : bp8 = b32)
    (hu1 : u1 = ap2 + ap6)
    (hu2 : u2 = ap5 - ap8)
    (hu3 : u3 = ap0 - u2)
    (hu4 : u4 = ap1 + ap4)
    (hu9 : u9 = ap0 + u1)
    (hu10 : u10 = ap1 + u1)
    (hu11 : u11 = ap7 - u2)
    (hu17 : u17 = ap3 - ap1)
    (hu13 : u13 = ap6 - u17)
    (hu15 : u15 = u11 - ap2)
    (hu19 : u19 = ap3 + u11)
    (hu23 : u23 = ap7 + u17)
    (hv1 : v1 = bp3 - bp1)
    (hv2 : v2 = bp7 + v1)
    (hv4 : v4 = bp8 - bp2)
    (hv7 : v7 = bp5 - v2)
    (hv10 : v10 = bp0 - v1)
    (hv11 : v11 = bp0 + bp4)
    (hv17 : v17 = bp8 - bp3)
    (hv13 : v13 = bp4 + v17)
    (hv15 : v15 = bp8 + v11)
    (hv18 : v18 = bp6 - v2)
    (hv19 : v19 = bp6 - v11)
    (hv23 : v23 = bp7 - v17)
    (hm1 : m1 = u1 * v1)
    (hm2 : m2 = u2 * v2)
    (hm3 : m3 = u3 * bp5)
    (hm4 : m4 = u4 * v4)
    (hm5 : m5 = ap8 * v4)
    (hm6 : m6 = u3 * bp2)
    (hm7 : m7 = u4 * v7)
    (hm8 : m8 = ap8 * v7)
    (hm9 : m9 = u9 * bp1)
    (hm10 : m10 = u10 * v10)
    (hm11 : m11 = u11 * v11)
    (hm12 : m12 = ap2 * bp0)
    (hm13 : m13 = u13 * v13)
    (hm14 : m14 = ap3 * bp4)
    (hm15 : m15 = u15 * v15)
    (hm16 : m16 = ap6 * bp3)
    (hm17 : m17 = u17 * v17)
    (hm18 : m18 = ap4 * v18)
    (hm19 : m19 = u19 * v19)
    (hm20 : m20 = ap5 * v18)
    (hm21 : m21 = ap7 * bp8)
    (hm22 : m22 = ap1 * bp7)
    (hm23 : m23 = u23 * v23)
    (hs1 : s1 = m7 - m16)
    (hs2 : s2 = m1 - m12)
    (hs3 : s3 = m14 - m5)
    (hs4 : s4 = m8 - m2)
    (hs5 : s5 = m17 - m8)
    (hs6 : s6 = m13 + m4)
    (hs7 : s7 = m22 + s1)
    (hs8 : s8 = m16 - s2)
    (hs9 : s9 = s3 - m21)
    (hs10 : s10 = s4 - m20)
    (hs11 : s11 = m21 + s5)
    (hs12 : s12 = m14 + s6)
    (hs13 : s13 = m10 - s8)
    (hs14 : s14 = m9 - s8)
    (hs15 : s15 = s10 - m11)
    (hs16 : s16 = s10 - m12)
    (hs17 : s17 = m22 + s11)
    (hs18 : s18 = m16 + s12)
    (hs19 : s19 = m18 + s13)
    (hs20 : s20 = s14 - m20)
    (hs21 : s21 = m14 - s15)
    (hs22 : s22 = s16 - m3)
    (hs23 : s23 = m6 + s16)
    (hs24 : s24 = m23 + s17)
    (hs25 : s25 = m17 + s18)
    (hs26 : s26 = m19 + s21)
    (hs27 : s27 = s23 - m15)
    (hs28 : s28 = m19 - s27)
    (hc11 : c11 = s19 - s7)
    (hc12 : c12 = s25)
    (hc13 : c13 = -s7)
    (hc21 : c21 = s26)
    (hc22 : c22 = -s9)
    (hc23 : c23 = s24)
    (hc31 : c31 = -s22)
    (hc32 : c32 = s26 - s28 - s9)
    (hc33 : c33 = s20 - s22) :
      c11 = a11 * b11 + a12 * b21 + a13 * b31 ∧
      c12 = a11 * b12 + a12 * b22 + a13 * b32 ∧
      c13 = a11 * b13 + a12 * b23 + a13 * b33 ∧
      c21 = a21 * b11 + a22 * b21 + a23 * b31 ∧
      c22 = a21 * b12 + a22 * b22 + a23 * b32 ∧
      c23 = a21 * b13 + a22 * b23 + a23 * b33 ∧
      c31 = a31 * b11 + a32 * b21 + a33 * b31 ∧
      c32 = a31 * b12 + a32 * b22 + a33 * b32 ∧
      c33 = a31 * b13 + a32 * b23 + a33 * b33 := by
  subst_vars
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> noncomm_ring

/-- The 52-addition alternative-basis scheme as a map on `3×3` matrices:
basis-changed inputs (`ap*`, `bp*`), the 12+12 input-side additions, the
23 multiplies, the 28 output-side additions, and the `BW⁻¹` output
basis change. -/
def scheme (A B : Matrix (Fin 3) (Fin 3) R) : Matrix (Fin 3) (Fin 3) R :=
  -- A-side basis change (not counted in the 52)
    let ap0 := A 2 0 + A 2 2
    let ap1 := -A 0 0 - A 0 2
    let ap2 := A 2 1
    let ap3 := -A 1 1
    let ap4 := A 0 2
    let ap5 := A 2 2
    let ap6 := A 0 0 + A 0 1 + A 0 2
    let ap7 := A 1 0 + A 1 1 + A 1 2
    let ap8 := -A 1 0
  -- B-side basis change (not counted in the 52)
    let bp0 := B 1 0
    let bp1 := -B 0 0 + B 0 2
    let bp2 := B 0 1
    let bp3 := B 1 2
    let bp4 := B 1 1 - B 2 1
    let bp5 := B 0 0
    let bp6 := B 2 0
    let bp7 := -B 1 2 + B 2 2
    let bp8 := B 2 1
  -- 12 adds on the A side
    let u1 := ap2 + ap6
    let u2 := ap5 - ap8
    let u3 := ap0 - u2
    let u4 := ap1 + ap4
    let u9 := ap0 + u1
    let u10 := ap1 + u1
    let u11 := ap7 - u2
    let u17 := ap3 - ap1
    let u13 := ap6 - u17
    let u15 := u11 - ap2
    let u19 := ap3 + u11
    let u23 := ap7 + u17
  -- 12 adds on the B side
    let v1 := bp3 - bp1
    let v2 := bp7 + v1
    let v4 := bp8 - bp2
    let v7 := bp5 - v2
    let v10 := bp0 - v1
    let v11 := bp0 + bp4
    let v17 := bp8 - bp3
    let v13 := bp4 + v17
    let v15 := bp8 + v11
    let v18 := bp6 - v2
    let v19 := bp6 - v11
    let v23 := bp7 - v17
  -- 23 multiplies
    let m1 := u1 * v1
    let m2 := u2 * v2
    let m3 := u3 * bp5
    let m4 := u4 * v4
    let m5 := ap8 * v4
    let m6 := u3 * bp2
    let m7 := u4 * v7
    let m8 := ap8 * v7
    let m9 := u9 * bp1
    let m10 := u10 * v10
    let m11 := u11 * v11
    let m12 := ap2 * bp0
    let m13 := u13 * v13
    let m14 := ap3 * bp4
    let m15 := u15 * v15
    let m16 := ap6 * bp3
    let m17 := u17 * v17
    let m18 := ap4 * v18
    let m19 := u19 * v19
    let m20 := ap5 * v18
    let m21 := ap7 * bp8
    let m22 := ap1 * bp7
    let m23 := u23 * v23
  -- 28 adds on the output side
    let s1 := m7 - m16
    let s2 := m1 - m12
    let s3 := m14 - m5
    let s4 := m8 - m2
    let s5 := m17 - m8
    let s6 := m13 + m4
    let s7 := m22 + s1
    let s8 := m16 - s2
    let s9 := s3 - m21
    let s10 := s4 - m20
    let s11 := m21 + s5
    let s12 := m14 + s6
    let s13 := m10 - s8
    let s14 := m9 - s8
    let s15 := s10 - m11
    let s16 := s10 - m12
    let s17 := m22 + s11
    let s18 := m16 + s12
    let s19 := m18 + s13
    let s20 := s14 - m20
    let s21 := m14 - s15
    let s22 := s16 - m3
    let s23 := m6 + s16
    let s24 := m23 + s17
    let s25 := m17 + s18
    let s26 := m19 + s21
    let s27 := s23 - m15
    let s28 := m19 - s27
  -- output basis change BW⁻¹ (not counted in the 52)
  !![s19 - s7, s25, -s7;
     s26, -s9, s24;
     -s22, s26 - s28 - s9, s20 - s22]

-- `scheme` unfolds to a ~100-binding straight-line program, so a single
-- elaboration exceeds the default heartbeat budget; raise it for this proof.
set_option maxHeartbeats 1600000 in
-- Plain `simp` (below) evaluates the concrete `!![..] i j` indexing via
-- Mathlib's matrix simprocs; the explicit `simp only` lemma set for this is
-- version-fragile, so we accept the flexible-`simp` lint here.
set_option linter.flexible false in
/-- The scheme computes the matrix product, in Mathlib's own terms. -/
theorem scheme_eq_mul (A B : Matrix (Fin 3) (Fin 3) R) :
    scheme A B = A * B := by
  simp only [scheme]                    -- unfold the SLP once (not per goal)
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three] <;>
    noncomm_ring

end Nielsen52

-- Axiom audit: a valid proof shows only Lean's standard axioms (no
-- `sorryAx`).
#print axioms Nielsen52.correct
#print axioms Nielsen52.scheme_eq_mul
