import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NoncommRing

/-!
# The Stapleton–Perminov 51-addition scheme, machine-checked

Correctness of the alternative-basis rank-23 3×3 scheme of Stapleton
and Perminov (arXiv:2609.32388), transcribed verbatim from the
verification listing in their paper
(`matmul/external/sp51/sp51_published.py`, with their certificate
`cert.json`); their reused variables `u22`, `v12` are SSA-renamed
`u22a`, `v12a`.  Generated by `matmul/gen_sp51_lean.py`, which replays
the program over the word ring ℤ⟨A,B⟩ and checks their basis matrices
`P`, `Q`, `R` are unimodular before writing this file.

Counted additions per recursive step: **13 (u chain) + 12 (v chain) +
26 (output stage) = 51**; the conversions (`x8`, `y2`, `y6`, `y8`, and
the final `z8 + z2`) cost 1+3+1 = 5 uncounted additions — their
one-shot flat total is 56, the cheapest known complete 51-package.
Their scheme lies in HKS class `i12w219c23ci-008` (family
`17x2+52x+4y6+5y4+14y3+z32+2z27`, the family of all four known
51-classes); our exact search proves legs 13+12+12 and conversions
1+3+1 are both optimal for the class (`fbmin`/`fbsmin` tiers).

The statement is over a general, not-necessarily-commutative ring:
each product keeps its A-side factor on the left, so the scheme
recurses on block matrices.

**To run this proof** (force a genuine re-elaboration — a plain
`lake build` replays the cached result of the last build):

```
cd proof && find .lake/build -name "SP51.*" -delete && lake build Mm.SP51
```

Expect `Built Mm.SP51` (not `Replayed`), followed by the two
`#print axioms` lines below — `[propext]` for `correct` and the three
standard axioms for `rank23_add51_scheme_eq_mul`, with no `sorryAx`.
A fresh checkout needs `lake exe cache get` in `proof/` once.
-/

namespace SP51

variable {R : Type _} [Ring R]

set_option maxHeartbeats 1600000 in
-- subst_vars inlines ~130 wires; each output is one large noncomm_ring
-- goal, which exceeds the default heartbeat budget.
/-- The Stapleton–Perminov 51-addition-per-step scheme computes `A · B`
over any ring. -/
theorem correct
    (a00 a01 a02 a10 a11 a12 a20 a21 a22
     b00 b01 b02 b10 b11 b12 b20 b21 b22 : R)
    (x0 x1 x2 x3 x4 x5 x6 x7 x8 y0
     y1 y2 y3 y4 y5 y6 y7 y8 u0 u1
     u2 u3 u4 u5 u6 u7 u8 u9 u10 u11
     u12 u13 u14 u15 u16 u17 u18 u22a u19 u20
     u21 u22 v0 v11 v7 v13 v21 v20 v14 v2
     v17 v22 v12a v1 v12 v3 v4 v5 v6 v8
     v9 v10 v15 v16 v18 v19 p0 p1 p2 p3
     p4 p5 p6 p7 p8 p9 p10 p11 p12 p13
     p14 p15 p16 p17 p18 p19 p20 p21 p22 t0
     t1 t2 t3 t4 t5 t6 z0 z1 z2 z3
     z4 z5 z6 z7 z8 c11 c12 c13 c21 c22
     c23 c31 c32 c33 : R)
    (hx0 : x0 = a00)
    (hx1 : x1 = a01)
    (hx2 : x2 = a02)
    (hx3 : x3 = a10)
    (hx4 : x4 = a11)
    (hx5 : x5 = a12)
    (hx6 : x6 = a20)
    (hx7 : x7 = a21)
    (hx8 : x8 = a22 - a20)
    (hy0 : y0 = b00)
    (hy1 : y1 = b01)
    (hy2 : y2 = b02 + b00)
    (hy3 : y3 = b10)
    (hy4 : y4 = b11)
    (hy5 : y5 = b12)
    (hy6 : y6 = b20 - b21)
    (hy7 : y7 = b21)
    (hy8 : y8 = b22 + b12)
    (hu0 : u0 = x0)
    (hu1 : u1 = x1)
    (hu2 : u2 = x1)
    (hu3 : u3 = x3)
    (hu4 : u4 = x4)
    (hu5 : u5 = x4)
    (hu6 : u6 = x5)
    (hu7 : u7 = x6)
    (hu8 : u8 = x7)
    (hu9 : u9 = x7)
    (hu10 : u10 = x8)
    (hu11 : u11 = x5 + x8)
    (hu12 : u12 = x1 - x2)
    (hu13 : u13 = x8 + u12)
    (hu14 : u14 = x6 + u13)
    (hu15 : u15 = x3 - u11)
    (hu16 : u16 = x7 - u14)
    (hu17 : u17 = x6 + u11)
    (hu18 : u18 = x4 - x5)
    (hu22a : u22a = x0 - u15)
    (hu19 : u19 = x2 - u22a)
    (hu20 : u20 = x5 + u19)
    (hu21 : u21 = x3 - u20)
    (hu22 : u22 = u17 - u22a)
    (hv0 : v0 = y2)
    (hv11 : v11 = y0 + y6)
    (hv7 : v7 = y1 - v11)
    (hv13 : v13 = y2 + v7)
    (hv21 : v21 = y6 + v13)
    (hv20 : v20 = y8 + v21)
    (hv14 : v14 = y7 + v20)
    (hv2 : v2 = y4 + v14)
    (hv17 : v17 = y7 + v11)
    (hv22 : v22 = y1 - v20)
    (hv12a : v12a = v13 - v14)
    (hv1 : v1 = y3 - v12a)
    (hv12 : v12 = y5 + v12a)
    (hv3 : v3 = y1)
    (hv4 : v4 = y3)
    (hv5 : v5 = y4)
    (hv6 : v6 = y7)
    (hv8 : v8 = y3)
    (hv9 : v9 = y4)
    (hv10 : v10 = y6)
    (hv15 : v15 = y0)
    (hv16 : v16 = y5)
    (hv18 : v18 = y5)
    (hv19 : v19 = y8)
    (hp0 : p0 = u0 * v0)
    (hp1 : p1 = u1 * v1)
    (hp2 : p2 = u2 * v2)
    (hp3 : p3 = u3 * v3)
    (hp4 : p4 = u4 * v4)
    (hp5 : p5 = u5 * v5)
    (hp6 : p6 = u6 * v6)
    (hp7 : p7 = u7 * v7)
    (hp8 : p8 = u8 * v8)
    (hp9 : p9 = u9 * v9)
    (hp10 : p10 = u10 * v10)
    (hp11 : p11 = u11 * v11)
    (hp12 : p12 = u12 * v12)
    (hp13 : p13 = u13 * v13)
    (hp14 : p14 = u14 * v14)
    (hp15 : p15 = u15 * v15)
    (hp16 : p16 = u16 * v16)
    (hp17 : p17 = u17 * v17)
    (hp18 : p18 = u18 * v18)
    (hp19 : p19 = u19 * v19)
    (hp20 : p20 = u20 * v20)
    (hp21 : p21 = u21 * v21)
    (hp22 : p22 = u22 * v22)
    (ht0 : t0 = p11 - p10 + p6)
    (ht1 : t1 = p20 + p21 - p3)
    (ht2 : t2 = p22 + t1)
    (ht3 : t3 = p17 - t0)
    (ht4 : t4 = p7 + t3)
    (ht5 : t5 = t4 - p14 - t2)
    (ht6 : t6 = p13 + t5)
    (hz0 : z0 = p0 + p1 + t6)
    (hz1 : z1 = p2 - p10 + p21 + t5)
    (hz2 : z2 = p12 - t6)
    (hz3 : z3 = p4 + p15 + t0)
    (hz4 : z4 = p5 + p6 + p3)
    (hz5 : z5 = p18 - p19 + t1)
    (hz6 : z6 = p8 + t3)
    (hz7 : z7 = p9 - p10 + t4)
    (hz8 : z8 = p16 - t2)
    (hc11 : c11 = z0)
    (hc12 : c12 = z1)
    (hc13 : c13 = z2)
    (hc21 : c21 = z3)
    (hc22 : c22 = z4)
    (hc23 : c23 = z5)
    (hc31 : c31 = z6)
    (hc32 : c32 = z7)
    (hc33 : c33 = z8 + z2) :
      c11 = a00 * b00 + a01 * b10 + a02 * b20 ∧
      c12 = a00 * b01 + a01 * b11 + a02 * b21 ∧
      c13 = a00 * b02 + a01 * b12 + a02 * b22 ∧
      c21 = a10 * b00 + a11 * b10 + a12 * b20 ∧
      c22 = a10 * b01 + a11 * b11 + a12 * b21 ∧
      c23 = a10 * b02 + a11 * b12 + a12 * b22 ∧
      c31 = a20 * b00 + a21 * b10 + a22 * b20 ∧
      c32 = a20 * b01 + a21 * b11 + a22 * b21 ∧
      c33 = a20 * b02 + a21 * b12 + a22 * b22 := by
  subst_vars
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> (first | noncomm_ring | abel)

/-- The Stapleton–Perminov scheme as a map on `3×3` matrices, in the
structure of `Ring51.rank23_add51_scheme`: UNCOUNTED unimodular input
conversions (1 and 3 additions), the COUNTED 13- and 12-addition input
chains, the 23 products, the COUNTED 26-addition output stage, and the
UNCOUNTED 1-addition output conversion.  Counted additions per
recursive step: 13 + 12 + 26 = **51**; one-shot flat total 56. -/
def rank23_add51_scheme (A B : Matrix (Fin 3) (Fin 3) R) :
    Matrix (Fin 3) (Fin 3) R :=
  -- A-side basis change (UNCOUNTED, amortized): x = P·vec A,
  -- applied once per matrix; 1 addition
  let x0 := A 0 0
  let x1 := A 0 1
  let x2 := A 0 2
  let x3 := A 1 0
  let x4 := A 1 1
  let x5 := A 1 2
  let x6 := A 2 0
  let x7 := A 2 1
  let x8 := A 2 2 - A 2 0
  -- B-side basis change (UNCOUNTED): y = Q·vec B; 3 additions
  let y0 := B 0 0
  let y1 := B 0 1
  let y2 := B 0 2 + B 0 0
  let y3 := B 1 0
  let y4 := B 1 1
  let y5 := B 1 2
  let y6 := B 2 0 - B 2 1
  let y7 := B 2 1
  let y8 := B 2 2 + B 1 2
  -- A-side chain: 13 COUNTED additions (paid per recursive step)
  let u0 := x0
  let u1 := x1
  let u2 := x1
  let u3 := x3
  let u4 := x4
  let u5 := x4
  let u6 := x5
  let u7 := x6
  let u8 := x7
  let u9 := x7
  let u10 := x8
  let u11 := x5 + x8
  let u12 := x1 - x2
  let u13 := x8 + u12
  let u14 := x6 + u13
  let u15 := x3 - u11
  let u16 := x7 - u14
  let u17 := x6 + u11
  let u18 := x4 - x5
  let u22a := x0 - u15
  let u19 := x2 - u22a
  let u20 := x5 + u19
  let u21 := x3 - u20
  let u22 := u17 - u22a
  -- B-side chain: 12 COUNTED additions
  let v0 := y2
  let v11 := y0 + y6
  let v7 := y1 - v11
  let v13 := y2 + v7
  let v21 := y6 + v13
  let v20 := y8 + v21
  let v14 := y7 + v20
  let v2 := y4 + v14
  let v17 := y7 + v11
  let v22 := y1 - v20
  let v12a := v13 - v14
  let v1 := y3 - v12a
  let v12 := y5 + v12a
  let v3 := y1
  let v4 := y3
  let v5 := y4
  let v6 := y7
  let v8 := y3
  let v9 := y4
  let v10 := y6
  let v15 := y0
  let v16 := y5
  let v18 := y5
  let v19 := y8
  -- the 23 products (A factor on the left: recurses on blocks)
  let p0 := u0 * v0
  let p1 := u1 * v1
  let p2 := u2 * v2
  let p3 := u3 * v3
  let p4 := u4 * v4
  let p5 := u5 * v5
  let p6 := u6 * v6
  let p7 := u7 * v7
  let p8 := u8 * v8
  let p9 := u9 * v9
  let p10 := u10 * v10
  let p11 := u11 * v11
  let p12 := u12 * v12
  let p13 := u13 * v13
  let p14 := u14 * v14
  let p15 := u15 * v15
  let p16 := u16 * v16
  let p17 := u17 * v17
  let p18 := u18 * v18
  let p19 := u19 * v19
  let p20 := u20 * v20
  let p21 := u21 * v21
  let p22 := u22 * v22
  -- output stage: 26 COUNTED additions (their published
  -- 12-addition output leg in transposed, 12+14-add form)
  let t0 := p11 - p10 + p6
  let t1 := p20 + p21 - p3
  let t2 := p22 + t1
  let t3 := p17 - t0
  let t4 := p7 + t3
  let t5 := t4 - p14 - t2
  let t6 := p13 + t5
  let z0 := p0 + p1 + t6
  let z1 := p2 - p10 + p21 + t5
  let z2 := p12 - t6
  let z3 := p4 + p15 + t0
  let z4 := p5 + p6 + p3
  let z5 := p18 - p19 + t1
  let z6 := p8 + t3
  let z7 := p9 - p10 + t4
  let z8 := p16 - t2
  -- output basis change (UNCOUNTED): vec C = R·z; 1 addition
  let c11 := z0
  let c12 := z1
  let c13 := z2
  let c21 := z3
  let c22 := z4
  let c23 := z5
  let c31 := z6
  let c32 := z7
  let c33 := z8 + z2
  !![c11, c12, c13;
     c21, c22, c23;
     c31, c32, c33]

-- `rank23_add51_scheme` unfolds to a ~130-binding straight-line
-- program; a single elaboration exceeds the default heartbeat budget.
set_option maxHeartbeats 1600000 in
-- Plain `simp` evaluates the concrete `!![..] i j` indexing via
-- Mathlib's matrix simprocs; the explicit lemma set is version-fragile,
-- so the flexible-`simp` lint is accepted here (as in Mm/Matrix.lean).
set_option linter.flexible false in
/-- The scheme computes the matrix product, in Mathlib's own terms. -/
theorem rank23_add51_scheme_eq_mul (A B : Matrix (Fin 3) (Fin 3) R) :
    rank23_add51_scheme A B = A * B := by
  simp only [rank23_add51_scheme]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three] <;>
    (first | noncomm_ring | abel)

end SP51

-- Axiom audit: a valid proof shows only Lean's standard axioms.
#print axioms SP51.correct
#print axioms SP51.rank23_add51_scheme_eq_mul
