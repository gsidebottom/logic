/-! ## Finite facts, checked in the kernel -/

section Facts

set_option maxRecDepth 100000

theorem legA_facts : legA.card = 20 ∧ (0 : Form) ∉ legA ∧ (triples legA).card = 9 := by
  decide +kernel

theorem legB_facts : legB.card = 20 ∧ (0 : Form) ∉ legB ∧ (triples legB).card = 9 := by
  decide +kernel

theorem legC_facts : legC.card = 20 ∧ (0 : Form) ∉ legC ∧ (triples legC).card = 10 := by
  decide +kernel

/-- Only five vectors outside leg A are the sum of two leg-A forms in three ways. -/
theorem helpersA_spec : ∀ h : Form, h ≠ 0 → h ∉ legA →
    6 ≤ (legA.filter (· + h ∈ legA)).card → h ∈ helpersA := by
  decide +kernel

set_option maxHeartbeats 1000000 in
-- unifying the five substituted helper literals with the `decide` goals needs more than
-- the default budget (the checks themselves run in the kernel)
/-- For each helper, leg A plus the helper has 12 sum triples, and a nonempty
family of them covers each of its members at least twice. -/
theorem cores_ok : ∀ h ∈ helpersA, ∃ K : Finset (Finset Form),
    K ⊆ triples (insert h legA) ∧ K.Nonempty ∧
      (∀ x ∈ K.biUnion id, 2 ≤ (K.filter (x ∈ ·)).card) ∧
      (triples (insert h legA)).card = 12 := by
  intro h hh
  simp only [helpersA, mem_insert, mem_singleton] at hh
  rcases hh with rfl | rfl | rfl | rfl | rfl
  · exact ⟨coreA0, by decide +kernel⟩
  · exact ⟨coreA1, by decide +kernel⟩
  · exact ⟨coreA2, by decide +kernel⟩
  · exact ⟨coreA3, by decide +kernel⟩
  · exact ⟨coreA4, by decide +kernel⟩

theorem chainA_ok : IsChain (fun i => chainA (Fin.castAdd 13 i)) chainA ∧
    ∀ t ∈ legA, ∃ i, chainA i = t := by
  unfold IsChain
  decide +kernel

theorem chainB_ok : IsChain (fun i => chainB (Fin.castAdd 12 i)) chainB ∧
    ∀ t ∈ legB, ∃ i, chainB i = t := by
  unfold IsChain
  decide +kernel

theorem chainC_ok : IsChain (fun i => chainC (Fin.castAdd 12 i)) chainC ∧
    ∀ t ∈ legC, ∃ i, chainC i = t := by
  unfold IsChain
  decide +kernel

theorem chainA_basis : LinearIndependent (ZMod 2) (fun i => chainA (Fin.castAdd 13 i)) := by
  rw [Fintype.linearIndependent_iff]
  decide +kernel

theorem chainB_basis : LinearIndependent (ZMod 2) (fun i => chainB (Fin.castAdd 12 i)) := by
  rw [Fintype.linearIndependent_iff]
  decide +kernel

theorem chainC_basis : LinearIndependent (ZMod 2) (fun i => chainC (Fin.castAdd 12 i)) := by
  rw [Fintype.linearIndependent_iff]
  decide +kernel

end Facts

/-! ## The legs' exact costs -/

/-- `T` can be computed with `n` additions *after a change of basis*: as
`Computable`, with linearly independent starting vectors. -/
def ComputableFromBasis (T : Finset Form) (n : ℕ) : Prop :=
  ∃ (s : Fin 9 → Form) (v : Fin (9 + n) → Form),
    LinearIndependent (ZMod 2) s ∧ IsChain s v ∧ ∀ t ∈ T, ∃ i, v i = t

/-- Leg A can be computed with 13 additions after a change of basis. -/
theorem legA_upper : ComputableFromBasis legA 13 :=
  ⟨_, chainA, chainA_basis, chainA_ok⟩

/-- Leg B can be computed with 12 additions after a change of basis. -/
theorem legB_upper : ComputableFromBasis legB 12 :=
  ⟨_, chainB, chainB_basis, chainB_ok⟩

/-- Leg C can be computed with 12 additions after a change of basis. -/
theorem legC_upper : ComputableFromBasis legC 12 :=
  ⟨_, chainC, chainC_basis, chainC_ok⟩

/-- Leg B needs at least 12 additions, from any nine starting vectors. -/
theorem legB_lower {n : ℕ} (h : Computable legB n) : 12 ≤ n := by
  by_contra hn
  have := card_le_of_computable form_add_self legB_facts.2.1 h (by rw [legB_facts.1]; omega)
  rw [legB_facts.1, legB_facts.2.2] at this
  omega

/-- Leg C needs at least 12 additions, from any nine starting vectors. -/
theorem legC_lower {n : ℕ} (h : Computable legC n) : 12 ≤ n := by
  by_contra hn
  have := card_le_of_computable form_add_self legC_facts.2.1 h (by rw [legC_facts.1]; omega)
  rw [legC_facts.1, legC_facts.2.2] at this
  omega

/-- Leg A needs at least 13 additions, from any nine starting vectors. -/
theorem legA_lower {n : ℕ} (hA : Computable legA n) : 13 ≤ n := by
  obtain ⟨s, v, hc, hT⟩ := hA
  by_contra hlt
  obtain ⟨h20, h0, h9⟩ := legA_facts
  have hsub : legA ⊆ vals v := fun t ht => by
    obtain ⟨i, rfl⟩ := hT t ht
    exact mem_filter.2 ⟨mem_image_of_mem _ (mem_univ _), fun h' => h0 (h' ▸ ht)⟩
  have hcard : (vals v).card ≤ 9 + n :=
    (card_filter_le _ _).trans (card_image_le.trans (by simp))
  have hbase := card_vals_le form_add_self hc ∅ (empty_subset _) (by simp)
  simp only [Finset.not_nonempty_empty, if_false, add_zero] at hbase
  by_cases he : vals v \ legA = ∅
  · have hS : vals v = legA := (sdiff_eq_empty_iff_subset.1 he).antisymm hsub
    rw [hS, h20, h9] at hbase
    omega
  · have hle1 : (vals v \ legA).card ≤ 1 := by rw [card_sdiff_of_subset hsub]; omega
    obtain ⟨h, hh⟩ := card_eq_one.1 (le_antisymm hle1 (card_pos.2 (nonempty_iff_ne_empty.2 he)))
    have hmem : h ∈ vals v \ legA := by rw [hh]; exact mem_singleton_self h
    obtain ⟨hhS, hhT⟩ := mem_sdiff.1 hmem
    have hS : vals v = insert h legA := by
      ext x
      constructor
      · intro hx
        by_cases hxT : x ∈ legA
        · exact mem_insert_of_mem hxT
        · have : x ∈ vals v \ legA := mem_sdiff.2 ⟨hx, hxT⟩
          rw [hh, mem_singleton] at this
          exact this ▸ mem_insert_self x legA
      · intro hx
        rcases mem_insert.1 hx with rfl | hx
        · exact hhS
        · exact hsub hx
    have hh0 : h ≠ 0 := (mem_filter.1 hhS).2
    rw [hS, card_insert_of_notMem hhT, h20] at hbase
    have hins := card_triples_insert_le form_add_self legA h
    rw [h9] at hins
    have hX : 6 ≤ (legA.filter (· + h ∈ legA)).card := by omega
    obtain ⟨K, hK, hKne, hdeg, h12⟩ := cores_ok h (helpersA_spec h hh0 hhT hX)
    have hcore := card_vals_le form_add_self hc K (by rw [hS]; exact hK) hdeg
    rw [hS, card_insert_of_notMem hhT, h20, h12, if_pos hKne] at hcore
    omega

/-! ## The class, and integer programs -/

theorem computable_image_iff (e : Form ≃+ Form) {T : Finset Form} {n : ℕ} :
    Computable (T.image e) n ↔ Computable T n := by
  constructor
  · intro h
    have := h.map e.symm.toAddMonoidHom
    simpa [image_image, Function.comp_def] using this
  · intro h
    simpa using h.map e.toAddMonoidHom

theorem ComputableFromBasis.image (e : Form ≃ₗ[ZMod 2] Form) {T : Finset Form} {n : ℕ}
    (h : ComputableFromBasis T n) : ComputableFromBasis (T.image e) n := by
  obtain ⟨s, v, hs, hc, hT⟩ := h
  refine ⟨e ∘ s, e ∘ v, hs.map' e.toLinearMap e.ker, hc.map e.toLinearMap.toAddMonoidHom, ?_⟩
  intro t ht
  obtain ⟨x, hx, rfl⟩ := mem_image.1 ht
  obtain ⟨i, hi⟩ := hT x hx
  exact ⟨i, by simp [hi]⟩

/-- **Stapleton and Perminov's 51 is optimal for its class.**  For any invertible
linear changes of coordinates `eA eB eC` (the class acts on each side this way),
any chains — from any nine starting vectors — that list the three legs use
`nA`, `nB`, `nC` additions with `nA + nB + (nC + 14) ≥ 51`; and `13`, `12`, `12`
are achieved after a change of basis. -/
theorem kernel_optimal_for_class (eA eB eC : Form ≃ₗ[ZMod 2] Form) :
    (∀ nA nB nC : ℕ, Computable (legA.image eA) nA → Computable (legB.image eB) nB →
        Computable (legC.image eC) nC → 51 ≤ nA + nB + (nC + 14)) ∧
      ComputableFromBasis (legA.image eA) 13 ∧ ComputableFromBasis (legB.image eB) 12 ∧
      ComputableFromBasis (legC.image eC) 12 := by
  refine ⟨fun nA nB nC hA hB hC => ?_, legA_upper.image eA, legB_upper.image eB,
    legC_upper.image eC⟩
  have a := legA_lower ((computable_image_iff eA.toAddEquiv).1 (by simpa using hA))
  have b := legB_lower ((computable_image_iff eB.toAddEquiv).1 (by simpa using hB))
  have c := legC_lower ((computable_image_iff eC.toAddEquiv).1 (by simpa using hC))
  omega

/-- Reduction mod 2 of integer coefficient matrices. -/
def mod2 : Matrix (Fin 3) (Fin 3) ℤ →+ Form :=
  (Int.castAddHom (ZMod 2)).mapMatrix

/-- **Integer programs are no better.**  Chains over `ℤ` (sums and differences)
whose entries reduce mod 2 to the three legs use `nA`, `nB`, `nC` additions with
`nA + nB + (nC + 14) ≥ 51`. -/
theorem kernel_optimal_over_int {nA nB nC : ℕ}
    {sA sB sC : Fin 9 → Matrix (Fin 3) (Fin 3) ℤ}
    {vA : Fin (9 + nA) → Matrix (Fin 3) (Fin 3) ℤ}
    {vB : Fin (9 + nB) → Matrix (Fin 3) (Fin 3) ℤ}
    {vC : Fin (9 + nC) → Matrix (Fin 3) (Fin 3) ℤ}
    (hA : IsChain sA vA) (hB : IsChain sB vB) (hC : IsChain sC vC)
    (lA : ∀ t ∈ legA, ∃ i, mod2 (vA i) = t) (lB : ∀ t ∈ legB, ∃ i, mod2 (vB i) = t)
    (lC : ∀ t ∈ legC, ∃ i, mod2 (vC i) = t) :
    51 ≤ nA + nB + (nC + 14) := by
  have a := legA_lower ⟨_, _, hA.map mod2, lA⟩
  have b := legB_lower ⟨_, _, hB.map mod2, lB⟩
  have c := legC_lower ⟨_, _, hC.map mod2, lC⟩
  omega

end SP51Optimal

