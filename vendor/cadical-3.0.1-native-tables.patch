+  if (!T.nwords) T.nwords = 1;
+  T.full.assign (T.nwords, 0);
+  for (size_t r = 0; r < nr; r++) T.full[r / 64] |= (uint64_t) 1 << (r % 64);
+  T.kill.assign (2 * vars.size () * T.nwords, 0);
+  for (size_t r = 0; r < nr; r++) {
