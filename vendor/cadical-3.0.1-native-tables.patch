+      assert (li < vars.size ());
+      // a row with the variable TRUE dies when it is assigned FALSE (value 0)
+      const size_t slot = (2 * li + (lit > 0 ? 0 : 1)) * T.nwords;
+      T.kill[slot + r / 64] |= (uint64_t) 1 << (r % 64);
